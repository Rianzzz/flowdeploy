# Copie este arquivo para ".env" e preencha com os seus dados.
# Sao so um PADRAO OPCIONAL: o servidor usa esses valores apenas quando o
# navegador nao manda contrato/authorization proprios (tela de Configuracoes,
# que fica salva so no localStorage de cada pessoa). Util pra uso solo, sem
# precisar abrir a tela de Configuracoes toda vez.

# Valor completo do header Authorization usado no Postman, ex:
# Key <base64 do seu usuario:senha do bot>
BLIP_AUTHORIZATION=

# Identificador do contrato no msging.net — so a parte antes de
# ".http.msging.net" (sem "https://", sem o resto do dominio, sem "/commands"), ex:
# wlck
BLIP_CONTRACT=wlck

# Porta em que o app local vai rodar
PORT=3000
